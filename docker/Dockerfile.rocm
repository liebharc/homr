# Run: docker build -f docker/Dockerfile.rocm -t homr . && docker run --device=/dev/kfd --device=/dev/dri --group-add video --group-add render --rm -p 33203:8000 homr
# Then: open http://localhost:33203/  or  curl -X POST -F "file=@tabi.jpg" http://localhost:33203/api/convert --output tabi.musicxml

FROM rocm/dev-ubuntu-24.04:7.0

WORKDIR /app

RUN apt update && apt install -y libgl1 libglib2.0-0 python3-venv python3-pip git

# The official wheel dynamically links these ROCm libraries.
RUN apt install -y miopen-hip hipfft rccl rocsolver rocblas

ENV LD_LIBRARY_PATH=/opt/rocm/lib:/opt/rocm-7.0.0/lib

RUN curl -sSL https://install.python-poetry.org | python3 -

RUN git clone https://github.com/liebharc/homr .

RUN /root/.local/bin/poetry install --only main --extras rocm

RUN /root/.local/bin/poetry run pip install --no-cache-dir -r docker/requirements.txt

RUN /root/.local/bin/poetry run python homr/main.py --init

EXPOSE 8000

CMD ["/root/.local/bin/poetry", "run", "uvicorn", "docker.web.app:app", "--host", "0.0.0.0", "--port", "8000"]
